{
    "watch": ["src/**/*.ts"],
    "ext": ".ts, .js, json",
    "exec": "ts-node ./src/cluster.ts",
    "execMap": {
      "ts": "ts-node --transpileOnly --nolazy -r ts-node/registe ./src/cluster.ts"
    },
    "ts-node": {
      "swc": true,
      "transpileOnly": true
    },
    "verbose": true,
    "ignore": ["node_modules", "dist"],
    "color": true,
    "restartable": "rs",
    "timestamp": "YYYY-MM-DD HH:mm:ss",
    "signal": "SIGINT",
    "restartDelay": 100,
    "eslintConfig": {
      "rules": {
        "semi": ["error", "always"],
        "quotes": ["error", "double"]
      }
    }
  }
  